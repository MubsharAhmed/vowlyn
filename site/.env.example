[TEMPLATE]
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional local-only Filament account created by `php artisan db:seed`.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound email. Leads are answered from the admin panel, so these values have
# to be set for a reply to actually reach anyone. While MAIL_MAILER=log the
# message is only written to storage/logs/laravel.log, and the admin panel warns
# that nothing is being delivered.
#
# Google Workspace / Gmail:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=hello@vowlyn.com
#   MAIL_PASSWORD=<16-character app password, not the account password>
#
# Other providers work the same way — only host, port and scheme change.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@vowlyn.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where a lead's answer lands when they reply to an email sent from the panel.
# For cold outreach this matters even more: a reply is the whole point of the
# campaign, so it must land in a mailbox a human actually reads.
MAIL_REPLY_TO_ADDRESS="hello@vowlyn.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

# Cold outreach guardrails. These defaults are deliberately conservative: a
# domain that suddenly sends hundreds of messages a day gets filtered, and that
# would break lead replies too. Raise OUTREACH_DAILY_LIMIT gradually, and only
# once the sending domain has some history of normal traffic.
OUTREACH_DAILY_LIMIT=40
OUTREACH_PER_RUN=20
OUTREACH_INTERVAL_SECONDS=3
OUTREACH_COOLDOWN_DAYS=30

# The sending window, in the timezone below. Outreach that arrives at 3am reads
# as automated; the same message at 9:30am reads as a person writing.
OUTREACH_WINDOW_START=09:00
OUTREACH_WINDOW_END=17:00
OUTREACH_WEEKDAYS_ONLY=true
OUTREACH_TIMEZONE=Europe/London

# A postal address is required by CAN-SPAM and expected under GDPR/PECR. It is
# appended to every outreach email next to the one-click unsubscribe link.
# Leaving it empty is allowed, but the admin panel warns about it.
OUTREACH_POSTAL_ADDRESS="Vowlyn Ltd, add your registered address here"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 web data stream.
GA4_MEASUREMENT_ID=G-XBKNTW9W3M
